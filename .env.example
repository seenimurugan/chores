# ---------------------------------------------------------------------------
# chores — environment variables
# Copy this file to .env, fill in real values, then run ./deploy.sh
# ---------------------------------------------------------------------------

# ── Kubernetes ──────────────────────────────────────────────────────────────
# Namespace to deploy into (must exist or deploy.sh will create it)
NAMESPACE=homelab

# ── Image tags ──────────────────────────────────────────────────────────────
# Bump these when you rebuild and want an immutable tag history.
# Images are built locally (imagePullPolicy: Never — OrbStack k3s reuses Mac Docker daemon).
BACKEND_IMAGE=chores-backend
BACKEND_TAG=0.4.0
FRONTEND_IMAGE=chores-frontend
FRONTEND_TAG=0.4

# ── Database (shared-postgres) ───────────────────────────────────────────────
# The chores app uses the cluster's shared Postgres, NOT a dedicated one.
# These values must match what is already provisioned in shared-postgres-secret.
# See: github.com/seenimurugan/homelab-cluster-setup  (shared-postgres docs)
KIDSTASKS_DB=kidstasks
KIDSTASKS_USER=kidstasks
KIDSTASKS_PASSWORD=change-me-to-real-password

# ── App secrets ──────────────────────────────────────────────────────────────
# JWT signing key — 256-bit base64 value.  Generate a new one:
#   openssl rand -base64 32
CHORES_JWT_SECRET=REPLACE-WITH-OUTPUT-OF-openssl-rand-base64-32

# Bootstrap admin — only used on first start when no admin user exists.
# Rotate the password in the DB afterwards (the bootstrap is skipped once an admin exists).
# See: docs/MAINTENANCE.md#rotate-admin-password
CHORES_ADMIN_USERNAME=admin
CHORES_ADMIN_PASSWORD=changeme
CHORES_ADMIN_DISPLAY_NAME=Admin
